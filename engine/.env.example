# Copy to .env (git-ignored) and run: uv run --env-file .env continuum-engine

# Hugging Face token for pyannote speaker separation. Accept the model terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1 first.
# Without it, speakers are labelled by audio source only (mic = me, system = others).
HF_TOKEN=

# Audio sources to capture: mic, system, or both.
CONTINUUM_SOURCES=mic,system

# Whisper model size: tiny, base, small, medium, large-v3.
CONTINUUM_WHISPER_MODEL=base

# Where models are downloaded. Defaults to the Hugging Face cache in your home folder.
# Put any path that contains spaces in double quotes, or uv drops the setting silently.
CONTINUUM_MODEL_DIR=

# Port of the local transcript WebSocket the desktop app connects to.
CONTINUUM_WS_PORT=8765

# Memory: who owns what is recorded. Set both to store transcripts; leave both
# empty to store nothing. Letters, digits, '_', '.', '-' only.
CONTINUUM_TENANT_ID=
CONTINUUM_PROJECT_ID=

# Where the memory database lives. Defaults to ~/.continuum/memory.
CONTINUUM_MEMORY_DIR=

# Markdown notes: when set, each meeting's transcript is also written here as
# a plain .md file (for example a folder inside your Obsidian vault).
CONTINUUM_NOTES_DIR=

# Actions. The assistant can only propose; you approve each one.
# Repositories where GitHub issues may be created (comma-separated owner/name).
# Empty means none.
CONTINUUM_GITHUB_REPOS=
# Token used only after you approve. Prefer a fine-grained token limited to
# "Issues: read and write" on the repositories above.
GITHUB_TOKEN=
# Jira Cloud issues (created as Tasks). Site must be https://<team>.atlassian.net;
# the API token comes from id.atlassian.com > Security > API tokens. All three
# are needed. Projects are the allowed project keys (comma-separated, e.g. WEB,OPS);
# empty means none.
CONTINUUM_JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
CONTINUUM_JIRA_PROJECTS=
# Slack incoming-webhook URL (https://hooks.slack.com/...). It fixes the one
# channel messages can go to. Empty means no Slack messages.
CONTINUUM_SLACK_WEBHOOK_URL=
# Google Calendar deadlines. All three are needed; the refresh token must have
# the https://www.googleapis.com/auth/calendar.events scope. Empty means none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar that receives deadlines. Defaults to your primary calendar.
CONTINUUM_GOOGLE_CALENDAR_ID=
