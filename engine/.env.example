# Copy to .env (git-ignored) and run: uv run --env-file .env continuum-engine

# Hugging Face token for pyannote speaker separation. Accept the model terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1 first.
# Without it, speakers are labelled by audio source only (mic = me, system = others).
HF_TOKEN=

# Audio sources to capture: mic, system, or both.
CONTINUUM_SOURCES=mic,system

# Whisper model size: tiny, base, small, medium, large-v3.
CONTINUUM_WHISPER_MODEL=base
# Speech runtime: auto (Apple Silicon GPU via mlx when installed with
# `uv sync --extra apple`, otherwise faster-whisper), faster-whisper, or mlx.
# On an M1, mlx transcribes about 3x faster; "small" on mlx runs as fast as
# "base" on faster-whisper and is more accurate.
CONTINUUM_ASR_BACKEND=auto

# Where models are downloaded. Defaults to the Hugging Face cache in your home folder.
# Put any path that contains spaces in double quotes, or uv drops the setting silently.
CONTINUUM_MODEL_DIR=

# Port of the local transcript WebSocket the desktop app connects to.
CONTINUUM_WS_PORT=8765

# Memory: who owns what is recorded. Set both to store transcripts; leave both
# empty to store nothing. Letters, digits, '_', '.', '-' only.
CONTINUUM_TENANT_ID=
CONTINUUM_PROJECT_ID=

# Where the memory database lives. Defaults to ~/.continuum/memory.
CONTINUUM_MEMORY_DIR=

# Privacy. Personal data and secrets (e-mails, phone and card numbers, IBANs,
# API keys, spoken passwords) are replaced by placeholders before transcripts
# are stored in memory or notes; the live transcript is unchanged. Set to 0 to
# store everything as said.
CONTINUUM_REDACT=1
# Delete memories older than this many days whenever the engine starts.
# Empty keeps everything. Notes files are yours and are never deleted.
CONTINUUM_RETENTION_DAYS=

# Meeting lifecycle. When a meeting ends ("End meeting" in the app, or after
# CONTINUUM_IDLE_END_MINUTES of silence) its AI summary is written into the
# notes and its action items are proposed (still approval-gated) to these
# targets: calendar, slack, email, notion, jira:PROJECT, github:owner/name (comma-separated).
# email drafts one recap to the calendar event's attendees, sent from your Gmail
# after you approve it (the Google refresh token also needs the
# https://www.googleapis.com/auth/gmail.send scope).
CONTINUUM_AUTO_PROPOSE=
CONTINUUM_IDLE_END_MINUTES=
# Save each meeting's audio next to its notes for playback (not redacted).
CONTINUUM_RECORD_AUDIO=0
# Ask the AI model about contradictions that involve no numbers (sends
# statements to your AI provider; at most one check every 20 s).
CONTINUUM_LLM_FACT_CHECK=0
# Show action items as they are said: the transcript so far goes to your AI
# provider at most every 3 minutes while people are talking.
CONTINUUM_LIVE_ACTION_ITEMS=0
# Store nothing (notes, memory, recordings, voices) unless FileVault is on.
# The live transcript still works. macOS only; elsewhere storing stops.
CONTINUUM_REQUIRE_DISK_ENCRYPTION=0

# Recognise people across meetings: when you name a speaker, their voice is
# kept in voices.json next to the memory folder (this computer only, readable
# by you only) and later meetings show their name. 0 turns it off; delete the
# file to forget every voice. Needs HF_TOKEN (speaker separation).
CONTINUUM_REMEMBER_VOICES=1

# Code context: comma-separated local checkouts. When a meeting names
# something in the code (a library, a module, a feature folder), the overlay
# lists the files involved. Indexed at start; nothing leaves this machine.
CONTINUUM_CODE_DIRS=

# Commitments and hesitations: promised dates ("done by Friday") and moments
# of doubt ("I'm not sure") are listed in the notes when a meeting ends.
# Phrase lists, on this computer. 0 turns it off.
CONTINUUM_RISK_TRACKING=1
# Also count the speaker's open Jira issues (needs the Jira settings below)
# and warn in the overlay when a promised date looks unrealistic. Sends the
# speaker's name to your Jira site.
CONTINUUM_WORKLOAD_CHECK=0

# Markdown notes: when set, each meeting's transcript is also written here as
# a plain .md file (for example a folder inside your Obsidian vault).
CONTINUUM_NOTES_DIR=

# AI model for meeting summaries and action items (continuum-summarize).
# Free options: groq (GROQ_API_KEY, console.groq.com), gemini (GEMINI_API_KEY,
# aistudio.google.com), openrouter (OPENROUTER_API_KEY + a ":free" model),
# mistral (MISTRAL_API_KEY), or fully local: ollama, lmstudio. Also openai,
# anthropic (Claude; needs `uv sync --extra claude` and ANTHROPIC_API_KEY), or
# custom (any OpenAI-compatible server: set CONTINUUM_LLM_BASE_URL).
# The transcript is sent to the provider you choose. Empty means no AI.
CONTINUUM_LLM_PROVIDER=
# Optional: another model than the provider's default, or the key for custom.
CONTINUUM_LLM_MODEL=
CONTINUUM_LLM_BASE_URL=
CONTINUUM_LLM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Actions. The assistant can only propose; you approve each one.
# Repositories where GitHub issues may be created (comma-separated owner/name).
# Empty means none.
CONTINUUM_GITHUB_REPOS=
# Token used only after you approve. Prefer a fine-grained token limited to
# "Issues: read and write" on the repositories above.
GITHUB_TOKEN=
# Jira Cloud issues (created as Tasks). Site must be https://<team>.atlassian.net;
# the API token comes from id.atlassian.com > Security > API tokens. All three
# are needed. Projects are the allowed project keys (comma-separated, e.g. WEB,OPS);
# empty means none.
CONTINUUM_JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
CONTINUUM_JIRA_PROJECTS=
# Notion: each meeting's summary as a page (target "notion"). Create an internal
# integration at notion.so/profile/integrations, share one parent page with it
# and paste that page's link or id. Both are needed; empty means none.
NOTION_TOKEN=
CONTINUUM_NOTION_PAGE_ID=
# Slack incoming-webhook URL (https://hooks.slack.com/...). It fixes the one
# channel messages can go to. Empty means no Slack messages.
CONTINUUM_SLACK_WEBHOOK_URL=
# Google Calendar deadlines. All three are needed; the refresh token must have
# the https://www.googleapis.com/auth/calendar.events scope. Empty means none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar that receives deadlines. Defaults to your primary calendar.
CONTINUUM_GOOGLE_CALENDAR_ID=
