{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "find ../../engine/src -name __pycache__ -type d -prune -exec rm -rf {} + ; pnpm build && ./scripts/fetch-uv.sh"
  },
  "bundle": {
    "externalBin": [
      "binaries/uv"
    ],
    "resources": {
      "../../../engine/src/recall/": "engine/src/recall/",
      "../../../engine/pyproject.toml": "engine/pyproject.toml",
      "../../../engine/uv.lock": "engine/uv.lock"
    }
  }
}
