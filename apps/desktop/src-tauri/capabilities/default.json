{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the fact-check overlay",
  "windows": [
    "main",
    "hud"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-ignore-cursor-events"
  ]
}
