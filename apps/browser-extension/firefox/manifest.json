{
  "manifest_version": 3,
  "name": "Recall call audio",
  "version": "0.1.0",
  "description": "Sends the other participants' audio of a web meeting to the Recall app on this computer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "call-audio@recall.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Recall: capture this call's audio"
  },
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/*",
    "https://app.slack.com/*",
    "https://*.webex.com/*",
    "https://whereby.com/*",
    "https://meet.jit.si/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*",
        "https://app.slack.com/*",
        "https://*.webex.com/*",
        "https://whereby.com/*",
        "https://meet.jit.si/*"
      ],
      "js": [
        "tap.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*",
        "https://app.slack.com/*",
        "https://*.webex.com/*",
        "https://whereby.com/*",
        "https://meet.jit.si/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
